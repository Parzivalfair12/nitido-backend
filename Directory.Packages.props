<Project>
  <!-- Versiones exactas, sin comodines. Verificadas contra nuget.org el 2026-10-18.
       Excepción: xunit.v3 y xunit.runner.visualstudio quedan en 3.x porque la 4.x no funciona con
       `dotnet test` en el SDK 10 sin cambiar global.json (la opción documentada es pasar a
       Microsoft.Testing.Platform). El resto está en la última versión estable. -->
  <PropertyGroup>
    <ManagePackageVersionsCentrally>true</ManagePackageVersionsCentrally>
    <CentralPackageTransitivePinningEnabled>true</CentralPackageTransitivePinningEnabled>
  </PropertyGroup>
  <ItemGroup>
    <!-- API -->
    <PackageVersion Include="FluentValidation" Version="12.2.0" />
    <PackageVersion Include="Microsoft.AspNetCore.DataProtection.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Hosting.Abstractions" Version="10.0.13" />
    <PackageVersion Include="Microsoft.Extensions.Identity.Core" Version="10.0.13" />
    <PackageVersion Include="Serilog.AspNetCore" Version="10.0.0" />
    <PackageVersion Include="Microsoft.AspNetCore.OpenApi" Version="10.0.13" />
    <!-- Base de datos -->
    <PackageVersion Include="Microsoft.EntityFrameworkCore.SqlServer" Version="10.0.13" />
    <PackageVersion Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.13" />
    <!-- Transitivo fijado por vulnerabilidad: Microsoft.Data.SqlClient 6.1.7 (que llega con EF Core) trae
         System.Security.Cryptography.Pkcs 9.0.11, con avisos NU1902 y NU1903 (GHSA-2fmv-rv2c-59x7 y GHSA-846f-f764-76mx),
         corregidos en 10.0.13. Quitar la línea cuando EF Core o SqlClient traigan una versión corregida. -->
    <PackageVersion Include="System.Security.Cryptography.Pkcs" Version="10.0.13" />
    <!-- Pruebas -->
    <PackageVersion Include="Testcontainers.MsSql" Version="4.16.0" />
    <PackageVersion Include="xunit.v3" Version="3.2.2" />
    <PackageVersion Include="xunit.runner.visualstudio" Version="3.1.5" />
    <PackageVersion Include="Microsoft.NET.Test.Sdk" Version="18.11.0" />
    <PackageVersion Include="coverlet.collector" Version="10.1.0" />
    <PackageVersion Include="Microsoft.AspNetCore.Mvc.Testing" Version="10.0.13" />
  </ItemGroup>
</Project>