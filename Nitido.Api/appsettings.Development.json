{
  "Serilog": {
    "WriteTo": {
      "Consola": {
        "Args": {
          "formatter": {
            "type": "Serilog.Formatting.Display.MessageTemplateTextFormatter, Serilog",
            "outputTemplate": "[{Timestamp:HH:mm:ss} {Level:u3}] {SourceContext}: {Message:lj}{NewLine}{Exception}"
          }
        }
      }
    }
  },
  "Registro": {
    "Habilitado": true
  }
}
