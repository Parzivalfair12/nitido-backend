{
  "Serilog": {
    "MinimumLevel": {
      "Default": "Information",
      "Override": {
        "Microsoft.AspNetCore": "Warning",
        "Microsoft.EntityFrameworkCore.Database.Command": "Warning"
      }
    },
    "WriteTo": {
      "Consola": {
        "Name": "Console",
        "Args": {
          "formatter": {
            "type": "Serilog.Formatting.Compact.RenderedCompactJsonFormatter, Serilog.Formatting.Compact"
          }
        }
      }
    },
    "Properties": {
      "Aplicacion": "nitido-api"
    }
  },
  "Registro": {
    "Habilitado": false
  },
  "Seguridad": {
    "Clave": {
      "LargoMinimo": 12
    },
    "Bloqueo": {
      "IntentosMaximos": 5,
      "Minutos": 15
    },
    "Sesion": {
      "MinutosInactividad": 30
    },
    "LimitePeticiones": {
      "PorMinuto": 10
    }
  },
  "AllowedHosts": "*"
}
